    <script>


        /* =====================================================
           ELEMENTS
        ===================================================== */

        const experience =
            document.querySelector(
                ".intro-experience"
            );


        const image =
            document.querySelector(
                "#awarenessImage"
            );


        const title =
            document.querySelector(
                "#introTitle"
            );


        const message =
            document.querySelector(
                "#introMessage"
            );


        const goldenAura =
            document.querySelector(
                "#goldenAura"
            );


        const scrollHint =
            document.querySelector(
                "#scrollHint"
            );


        const navbar =
            document.querySelector(
                "#navbar"
            );



        /* =====================================================
           SCROLL EXPERIENCE
        ===================================================== */

        function updateExperience() {


            const rect =
                experience.getBoundingClientRect();


            const total =
                experience.offsetHeight -
                window.innerHeight;


            let progress =
                -rect.top / total;


            progress =
                Math.min(
                    Math.max(progress, 0),
                    1
                );



            /* ---------------------------------------------
               IMAGE
            --------------------------------------------- */

            /*
                Starts almost invisible.
                Slowly becomes larger and visible.
            */

            const imageProgress =
                Math.min(
                    Math.max(
                        (progress - 0.05) / 0.58,
                        0
                    ),
                    1
                );


            const imageScale =
                0.72 +
                (imageProgress * 0.28);


            const imageOpacity =
                imageProgress;


            image.style.transform = `
                translate(-50%, -50%)
                scale(${imageScale})
            `;


            image.style.opacity =
                imageOpacity;



            /* ---------------------------------------------
               GOLDEN AURA
            --------------------------------------------- */

            const auraProgress =
                Math.min(
                    Math.max(
                        (progress - 0.05) / 0.5,
                        0
                    ),
                    1
                );


            goldenAura.style.opacity =
                auraProgress * 0.9;


            goldenAura.style.transform = `
                translate(-50%, -50%)
                scale(${0.8 + auraProgress * 0.3})
            `;



            /* ---------------------------------------------
               TITLE
            --------------------------------------------- */

            /*
                Title remains visible initially.
                Then slowly disappears.
            */

            const titleProgress =
                Math.min(
                    Math.max(
                        progress / 0.38,
                        0
                    ),
                    1
                );


            const titleOpacity =
                1 -
                titleProgress;


            const titleMove =
                titleProgress * -80;


            title.style.opacity =
                titleOpacity;


            title.style.transform = `
                translate(-50%, calc(-50% + ${titleMove}px))
            `;



            /* ---------------------------------------------
               MESSAGE
            --------------------------------------------- */

            /*
                Appears after the image
                becomes visible.
            */

            const messageProgress =
                Math.min(
                    Math.max(
                        (progress - 0.58) / 0.30,
                        0
                    ),
                    1
                );


            const messageMove =
                50 -
                (messageProgress * 50);


            message.style.opacity =
                messageProgress;


            message.style.transform = `
                translate(-50%, calc(-50% + ${messageMove}px))
            `;



            /* ---------------------------------------------
               SCROLL HINT
            --------------------------------------------- */

            if (progress > 0.08) {

                scrollHint.style.opacity =
                    "0";

            } else {

                scrollHint.style.opacity =
                    "1";
            }

        }



        /* =====================================================
           NAVBAR
        ===================================================== */

        function updateNavbar() {

            if (window.scrollY > 80) {

                navbar.classList.add(
                    "scrolled"
                );

            } else {

                navbar.classList.remove(
                    "scrolled"
                );

            }

        }



        /* =====================================================
           SCROLL EVENT
        ===================================================== */

        let ticking = false;


        window.addEventListener(
            "scroll",
            () => {

                if (!ticking) {

                    window.requestAnimationFrame(
                        () => {

                            updateExperience();

                            updateNavbar();

                            ticking = false;

                        }
                    );

                    ticking = true;
                }

            },
            { passive: true }
        );



        /* =====================================================
           INITIAL STATE
        ===================================================== */

        updateExperience();

        updateNavbar();



        /* =====================================================
           IMAGE ERROR HANDLER
        ===================================================== */

        image.addEventListener(
            "error",
            () => {

                console.warn(
                    "A imagem deep-awareness.png não foi encontrada. Certifica-te de que está na mesma pasta que o index.html."
                );

            }
        );


    </script>


