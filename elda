
<!DOCTYPE html>
<html lang="pt-PT">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Deep Awareness — Hipnoterapia Ericksoniana. Um espaço para abrandar, escutar e reencontrar os teus próprios recursos."
    >

    <title>
        Deep Awareness — Hipnoterapia Ericksoniana
    </title>


    <!-- Google Fonts -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=DM+Sans:wght@300;400;500&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =====================================================
           ROOT
        ===================================================== */

        :root {

            --navy:
                #020A1B;

            --navy-deep:
                #010612;

            --blue:
                #071A35;

            --blue-light:
                #102B4A;

            --gold:
                #D9A441;

            --gold-light:
                #F0C96A;

            --ivory:
                #F5F0E6;

            --ivory-soft:
                #E8E3D8;

            --text-muted:
                #AAA9A2;

            --dark-text:
                #151A22;

            --border:
                rgba(217, 164, 65, 0.28);

            --serif:
                "Cormorant Garamond",
                Georgia,
                serif;

            --sans:
                "DM Sans",
                Arial,
                sans-serif;
        }



        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            background:
                var(--navy);

            color:
                var(--ivory);

            font-family:
                var(--sans);

            overflow-x:
                hidden;
        }


        img {
            display:
                block;

            max-width:
                100%;
        }


        a {
            color:
                inherit;

            text-decoration:
                none;
        }


        button {
            font:
                inherit;
        }



        /* =====================================================
           NOISE / GRAIN
        ===================================================== */

        body::before {

            content:
                "";

            position:
                fixed;

            inset:
                0;

            z-index:
                999;

            pointer-events:
                none;

            opacity:
                0.035;

            background-image:
                url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.5'/%3E%3C/svg%3E");

            mix-blend-mode:
                soft-light;
        }



        /* =====================================================
           NAVBAR
        ===================================================== */

        .navbar {

            position:
                fixed;

            top:
                0;

            left:
                0;

            width:
                100%;

            height:
                90px;

            padding:
                0 5vw;

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            z-index:
                100;

            transition:
                background 0.5s ease,
                backdrop-filter 0.5s ease,
                border 0.5s ease;
        }


        .navbar.scrolled {

            background:
                rgba(2, 10, 27, 0.82);

            backdrop-filter:
                blur(18px);

            border-bottom:
                1px solid rgba(217, 164, 65, 0.12);
        }


        .logo {

            display:
                flex;

            flex-direction:
                column;

            line-height:
                0.9;

            font-family:
                var(--sans);

            font-size:
                10px;

            font-weight:
                500;

            letter-spacing:
                0.27em;

            color:
                var(--gold-light);
        }


        .logo span:last-child {

            margin-left:
                12px;

            margin-top:
                5px;
        }


        .navigation {

            display:
                flex;

            align-items:
                center;

            gap:
                30px;

            font-size:
                10px;

            letter-spacing:
                0.09em;

            text-transform:
                uppercase;
        }


        .navigation a {

            position:
                relative;

            color:
                rgba(245, 240, 230, 0.72);

            transition:
                color 0.3s ease;
        }


        .navigation a:not(.nav-button)::after {

            content:
                "";

            position:
                absolute;

            left:
                0;

            bottom:
                -7px;

            width:
                0;

            height:
                1px;

            background:
                var(--gold);

            transition:
                width 0.3s ease;
        }


        .navigation a:hover {

            color:
                var(--gold-light);
        }


        .navigation a:hover::after {

            width:
                100%;
        }


        .nav-button {

            padding:
                12px 19px;

            border:
                1px solid var(--border);

            color:
                var(--gold-light) !important;

            transition:
                background 0.3s ease,
                border-color 0.3s ease;
        }


        .nav-button:hover {

            background:
                rgba(217, 164, 65, 0.08);

            border-color:
                var(--gold);
        }



        /* =====================================================
           INTRO EXPERIENCE
           
           This is the first "world" of the website.
        ===================================================== */

        .intro-experience {

            position:
                relative;

            height:
                270vh;

            background:
                var(--navy);
        }


        .intro-stage {

            position:
                sticky;

            top:
                0;

            height:
                100vh;

            min-height:
                650px;

            overflow:
                hidden;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;
        }


        /* Main atmospheric glow */

        .intro-glow {

            position:
                absolute;

            width:
                650px;

            height:
                650px;

            left:
                50%;

            top:
                48%;

            transform:
                translate(-50%, -50%);

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(20, 63, 96, 0.55),
                    rgba(2, 10, 27, 0) 70%
                );

            filter:
                blur(25px);

            pointer-events:
                none;
        }


        /* Golden aura behind the image */

        .intro-golden-aura {

            position:
                absolute;

            width:
                500px;

            height:
                500px;

            left:
                50%;

            top:
                46%;

            transform:
                translate(-50%, -50%);

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(217, 164, 65, 0.18),
                    rgba(217, 164, 65, 0) 68%
                );

            filter:
                blur(40px);

            opacity:
                0;

            pointer-events:
                none;
        }


        /* =====================================================
           IMAGE
        ===================================================== */

        .awareness-image {

            position:
                absolute;

            left:
                50%;

            top:
                51%;

            width:
                min(700px, 65vw);

            max-height:
                90vh;

            object-fit:
                contain;

            transform:
                translate(-50%, -50%)
                scale(0.72);

            opacity:
                0;

            filter:
                brightness(0.72)
                saturate(0.85);

            will-change:
                transform,
                opacity;

            pointer-events:
                none;

            z-index:
                2;
        }


        /* Soft mask so image melts into background */

        .image-mask {

            position:
                absolute;

            inset:
                0;

            z-index:
                3;

            pointer-events:
                none;

            background:
                radial-gradient(
                    ellipse at center,
                    transparent 20%,
                    rgba(2, 10, 27, 0.12) 55%,
                    var(--navy) 82%
                );
        }



        /* =====================================================
           HERO TITLE
        ===================================================== */

        .intro-title {

            position:
                absolute;

            z-index:
                5;

            top:
                50%;

            left:
                50%;

            transform:
                translate(-50%, -50%);

            width:
                90%;

            max-width:
                1000px;

            text-align:
                center;

            will-change:
                opacity,
                transform;
        }


        .intro-title .eyebrow {

            margin-bottom:
                25px;

            font-size:
                10px;

            letter-spacing:
                0.4em;

            color:
                var(--gold-light);
        }


        .intro-title h1 {

            font-family:
                var(--serif);

            font-weight:
                400;

            font-size:
                clamp(70px, 11vw, 155px);

            line-height:
                0.73;

            letter-spacing:
                0.025em;

            color:
                var(--ivory);
        }


        .intro-title h1 span {

            color:
                transparent;

            -webkit-text-stroke:
                1px var(--gold-light);
        }


        .intro-line {

            width:
                60px;

            height:
                1px;

            margin:
                42px auto 28px;

            background:
                var(--gold);
        }


        .intro-title h2 {

            font-family:
                var(--serif);

            font-size:
                clamp(28px, 4vw, 48px);

            line-height:
                1.05;

            font-weight:
                400;
        }



        /* =====================================================
           MESSAGE AFTER IMAGE
        ===================================================== */

        .intro-message {

            position:
                absolute;

            z-index:
                7;

            left:
                50%;

            top:
                70%;

            transform:
                translate(-50%, -50%);

            width:
                90%;

            max-width:
                760px;

            text-align:
                center;

            opacity:
                0;

            will-change:
                opacity,
                transform;
        }


        .intro-message p {

            font-family:
                var(--serif);

            font-size:
                clamp(42px, 6vw, 78px);

            line-height:
                0.95;

            color:
                var(--ivory);
        }


        .intro-message span {

            display:
                block;

            margin-top:
                25px;

            color:
                var(--gold-light);

            font-family:
                var(--serif);

            font-size:
                clamp(20px, 2.5vw, 30px);

            font-style:
                italic;
        }



        /* =====================================================
           SCROLL INDICATOR
        ===================================================== */

        .scroll-hint {

            position:
                absolute;

            bottom:
                30px;

            left:
                50%;

            transform:
                translateX(-50%);

            z-index:
                10;

            display:
                flex;

            flex-direction:
                column;

            align-items:
                center;

            gap:
                10px;

            font-size:
                8px;

            letter-spacing:
                0.3em;

            color:
                rgba(245, 240, 230, 0.5);

            transition:
                opacity 0.3s ease;
        }


        .scroll-hint span {

            width:
                1px;

            height:
                40px;

            background:
                linear-gradient(
                    to bottom,
                    var(--gold),
                    transparent
                );

            animation:
                scrollPulse 2s infinite;
        }


        @keyframes scrollPulse {

            0%,
            100% {
                opacity:
                    0.3;
            }

            50% {
                opacity:
                    1;
            }
        }



        /* =====================================================
           SECTION INTRO
        ===================================================== */

        .intro-section {

            position:
                relative;

            padding:
                170px 8vw;

            background:
                var(--ivory);

            color:
                var(--dark-text);

            text-align:
                center;
        }


        .section-label {

            margin-bottom:
                25px;

            font-size:
                9px;

            letter-spacing:
                0.3em;

            text-transform:
                uppercase;

            color:
                var(--gold);
        }


        .intro-section-inner {

            max-width:
                850px;

            margin:
                0 auto;
        }


        .intro-section h2 {

            font-family:
                var(--serif);

            font-size:
                clamp(45px, 6vw, 78px);

            font-weight:
                400;

            line-height:
                0.95;
        }


        .intro-section h2 em {

            color:
                #77746A;

            font-style:
                italic;
        }


        .intro-section-text {

            max-width:
                620px;

            margin:
                40px auto 0;

            font-size:
                15px;

            line-height:
                2;

            color:
                #626058;
        }



        /* =====================================================
           QUOTE
        ===================================================== */

        .quote-section {

            padding:
                130px 8vw;

            background:
                var(--ivory);

            text-align:
                center;

            color:
                var(--dark-text);
        }


        .quote {

            max-width:
                850px;

            margin:
                auto;

            font-family:
                var(--serif);

            font-size:
                clamp(32px, 4vw, 52px);

            font-weight:
                400;

            line-height:
                1.1;
        }


        .quote-mark {

            display:
                block;

            margin-bottom:
                20px;

            color:
                var(--gold);

            font-size:
                50px;
        }


        .quote-author {

            display:
                block;

            margin-top:
                25px;

            font-family:
                var(--sans);

            font-size:
                10px;

            letter-spacing:
                0.2em;

            text-transform:
                uppercase;

            color:
                #77746A;
        }



        /* =====================================================
           APPROACH
        ===================================================== */

        .approach {

            position:
                relative;

            min-height:
                800px;

            padding:
                130px 8vw;

            display:
                grid;

            grid-template-columns:
                1fr 1fr;

            gap:
                9vw;

            align-items:
                center;

            background:
                var(--blue);

            overflow:
                hidden;
        }


        .approach-visual {

            min-height:
                520px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            position:
                relative;
        }


        /* Main geometric circle */

        .orb {

            width:
                min(430px, 38vw);

            height:
                min(430px, 38vw);

            border-radius:
                50%;

            border:
                1px solid var(--gold);

            position:
                relative;

            box-shadow:
                0 0 80px rgba(217, 164, 65, 0.08);
        }


        .orb::before,
        .orb::after {

            content:
                "";

            position:
                absolute;

            border-radius:
                50%;

            border:
                1px solid rgba(217, 164, 65, 0.3);
        }


        .orb::before {
            inset:
                50px;
        }


        .orb::after {
            inset:
                105px;
        }


        .orb-center {

            position:
                absolute;

            width:
                80px;

            height:
                80px;

            left:
                50%;

            top:
                50%;

            transform:
                translate(-50%, -50%);

            border-radius:
                50%;

            border:
                1px solid var(--gold);

            box-shadow:
                0 0 50px rgba(217, 164, 65, 0.3);

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;
        }


        .orb-center::after {

            content:
                "";

            width:
                8px;

            height:
                8px;

            border-radius:
                50%;

            background:
                var(--gold-light);

            box-shadow:
                0 0 30px var(--gold);
        }


        .approach-content {

            max-width:
                560px;
        }


        .approach-content h2 {

            font-family:
                var(--serif);

            font-weight:
                400;

            font-size:
                clamp(45px, 6vw, 78px);

            line-height:
                0.92;
        }


        .approach-content h2 em {

            color:
                var(--gold-light);

            font-style:
                italic;
        }


        .approach-content p {

            margin-top:
                30px;

            color:
                var(--text-muted);

            font-size:
                15px;

            line-height:
                1.9;
        }


        .text-link {

            display:
                inline-block;

            margin-top:
                38px;

            padding-bottom:
                8px;

            border-bottom:
                1px solid var(--gold);

            color:
                var(--gold-light);

            font-size:
                10px;

            letter-spacing:
                0.15em;

            text-transform:
                uppercase;
        }



        /* =====================================================
           AREAS
        ===================================================== */

        .areas {

            padding:
                160px 7vw;

            background:
                var(--navy);
        }


        .areas-header {

            max-width:
                800px;

            margin-bottom:
                75px;
        }


        .areas-header h2 {

            font-family:
                var(--serif);

            font-size:
                clamp(48px, 6vw, 82px);

            font-weight:
                400;

            line-height:
                0.92;
        }


        .areas-header h2 em {

            color:
                var(--gold-light);

            font-style:
                italic;
        }


        .areas-grid {

            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                20px;
        }


        .area-card {

            min-height:
                350px;

            padding:
                35px;

            border:
                1px solid var(--border);

            position:
                relative;

            transition:
                transform 0.5s ease,
                background 0.5s ease,
                border-color 0.5s ease;
        }


        .area-card:hover {

            transform:
                translateY(-8px);

            background:
                rgba(217, 164, 65, 0.04);

            border-color:
                rgba(217, 164, 65, 0.55);
        }


        .area-number {

            font-family:
                var(--serif);

            font-size:
                20px;

            color:
                var(--gold);
        }


        .area-card h3 {

            margin-top:
                90px;

            font-family:
                var(--serif);

            font-size:
                32px;

            font-weight:
                400;

            line-height:
                0.95;
        }


        .area-card p {

            margin-top:
                22px;

            color:
                var(--text-muted);

            font-size:
                13px;

            line-height:
                1.8;
        }



        /* =====================================================
           PROCESS
        ===================================================== */

        .process {

            padding:
                160px 7vw;

            background:
                var(--ivory);

            color:
                var(--dark-text);
        }


        .process-header {

            max-width:
                750px;

            margin-bottom:
                90px;
        }


        .process-header h2 {

            font-family:
                var(--serif);

            font-size:
                clamp(48px, 6vw, 82px);

            font-weight:
                400;

            line-height:
                0.9;
        }


        .process-header h2 em {

            color:
                #77746A;

            font-style:
                italic;
        }


        .process-grid {

            display:
                grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap:
                30px;
        }


        .process-item {

            padding-top:
                25px;

            border-top:
                1px solid rgba(2, 10, 27, 0.25);
        }


        .process-item-number {

            color:
                var(--gold);

            font-family:
                var(--serif);

            font-size:
                20px;
        }


        .process-item h3 {

            margin-top:
                45px;

            font-family:
                var(--serif);

            font-size:
                27px;

            font-weight:
                400;
        }


        .process-item p {

            margin-top:
                15px;

            color:
                #66635B;

            font-size:
                13px;

            line-height:
                1.8;
        }



        /* =====================================================
           ABOUT
        ===================================================== */

        .about {

            display:
                grid;

            grid-template-columns:
                1fr 1fr;

            min-height:
                750px;

            background:
                var(--blue-light);
        }


        .about-image {

            min-height:
                600px;

            background:
                linear-gradient(
                    rgba(2, 10, 27, 0.2),
                    rgba(2, 10, 27, 0.35)
                );
        }


        .about-image-placeholder {

            width:
                100%;

            height:
                100%;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            background:
                radial-gradient(
                    circle at center,
                    #33475C,
                    #111E30 65%,
                    #07101E
                );

            color:
                rgba(245, 240, 230, 0.4);

            font-family:
                var(--serif);

            font-size:
                28px;

            font-style:
                italic;
        }


        .about-content {

            padding:
                100px 8vw;

            display:
                flex;

            flex-direction:
                column;

            justify-content:
                center;
        }


        .about-content h2 {

            font-family:
                var(--serif);

            font-size:
                clamp(45px, 5vw, 70px);

            font-weight:
                400;

            line-height:
                0.95;
        }


        .about-content h2 em {

            color:
                var(--gold-light);

            font-style:
                italic;
        }


        .about-content p {

            margin-top:
                30px;

            max-width:
                500px;

            color:
                var(--text-muted);

            line-height:
                1.9;

            font-size:
                14px;
        }


        .credentials {

            margin-top:
                45px;

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                10px;
        }


        .credential {

            padding:
                9px 13px;

            border:
                1px solid rgba(217, 164, 65, 0.25);

            color:
                var(--gold-light);

            font-size:
                9px;

            letter-spacing:
                0.08em;

            text-transform:
                uppercase;
        }



        /* =====================================================
           FINAL CONTACT
        ===================================================== */

        .contact {

            min-height:
                800px;

            position:
                relative;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            text-align:
                center;

            overflow:
                hidden;

            background:
                var(--navy-deep);
        }


        .contact-glow {

            position:
                absolute;

            width:
                700px;

            height:
                700px;

            border-radius:
                50%;

            background:
                radial-gradient(
                    circle,
                    rgba(217, 164, 65, 0.12),
                    transparent 65%
                );

            filter:
                blur(30px);
        }


        .contact-ring {

            position:
                absolute;

            width:
                600px;

            height:
                600px;

            border-radius:
                50%;

            border:
                1px solid rgba(217, 164, 65, 0.2);
        }


        .contact-ring::before {

            content:
                "";

            position:
                absolute;

            inset:
                70px;

            border-radius:
                50%;

            border:
                1px solid rgba(217, 164, 65, 0.12);
        }


        .contact-content {

            position:
                relative;

            z-index:
                5;

            max-width:
                850px;

            padding:
                60px 25px;
        }


        .contact-content h2 {

            font-family:
